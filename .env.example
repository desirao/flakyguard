# FlakyGuard-AI Environment Configuration

# Core Server Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-super-secret-key-32chars

# CI/CD Webhook & Git Integration
GITHUB_WEBHOOK_SECRET=flakyguard-ci-hmac-secret-test
GITHUB_TOKEN=ghp_example_pat_with_repo_scope_permissions
DEFAULT_REPO=desirao/flakyguard

# Semantic Code Search (Sourcegraph OSS)
SOURCEGRAPH_URL=http://localhost:7080
SOURCEGRAPH_TOKEN=
SOURCEGRAPH_FALLBACK_GIT=true

# Datastores
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://flakyguard:flakyguard_dev_password@localhost:5432/flakyguard_db

# LLM Providers & Agent Configuration
DEFAULT_LLM_PROVIDER=heuristic
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Observability
PROMETHEUS_METRICS_ENABLED=true
